name: retries

executors:
  - { name: bench, type: grpc, host: 127.0.0.1, port: 9201 }

setup:
  - name: fixture/power_on
    executor: bench
  - name: fixture/connect
    executor: bench
    retries: 3

main:
  - name: board/measure_rail
    executor: bench
    limit: { type: range, min: 4.75, max: 5.25 }

cleanup:
  - name: fixture/power_off
    executor: bench
