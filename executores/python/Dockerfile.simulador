# Dockerfile del simulador de instrumento TCP (stand-in).
#
# Contenedor mínimo que corre simulador_tcp.py. No necesita gRPC, solo
# Python estándar (socket). Vive en la red interna red_lid y no expone
# puertos al host.

FROM python:3.12-slim

WORKDIR /lid
COPY simulador_tcp.py ./

EXPOSE 4000

CMD ["python3", "simulador_tcp.py"]