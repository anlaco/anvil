{
  "name": "@anvil/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Graphical sequence editor for Anvil. Runs the engine guest in a plain browser, or wrapped by Electron for download (ADR-0037).",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/anlaco/anvil",
  "author": {
    "name": "ANLACO",
    "email": "anlaco@proton.me"
  },
  "scripts": {
    "transpile": "node scripts/transpile.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "dev": "vite",
    "build": "vite build",
    "app": "node scripts/dev-app.mjs",
    "app:build": "npm run build && electron-builder",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "^0.23.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "codemirror": "^6.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco-transpile": "^0.12.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "org.anlaco.anvil.editor",
    "productName": "Anvil Sequence Editor",
    "copyright": "AGPL-3.0-or-later",
    "directories": {
      "output": "../dist-app",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "anvil-editor",
      "maintainer": "ANLACO <anlaco@proton.me>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "deb": {
      "packageName": "anvil-editor",
      "artifactName": "anvil-editor_${version}_${arch}.${ext}"
    }
  }
}
