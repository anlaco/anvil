# idioma: es

# Compara dos listas de bytes elemento a elemento. Hace falta porque Ana
# no tiene conversión de bytes a texto (anlaco-lang#6): un nombre de
# campo que llega decodificado como lista de bytes no se puede comparar
# con un texto Ana vía "es" (tipos distintos, error en v0.4) — se
# compara con otra lista de bytes construida con "bytes de" en su lugar.
define coincide de recibido, esperado:
    si (cantidad de recibido) no es (cantidad de esperado):
        devuelve falso
    fin
    la total es cantidad de esperado
    el i es 1
    el iguales es verdadero
    mientras i es menor que (total + 1):
        el a1 es elemento i de recibido
        el b1 es elemento i de esperado
        si a1 no es b1:
            el iguales es falso
        fin
        el i es (i + 1)
    fin
    devuelve iguales
fin

define varint_bytes de un valor:
    la lista_bytes son []
    el resto_ es valor
    mientras resto_ es mayor que 127:
        el octeto es ((resto de resto_ entre 128) + 128)
        añade octeto a lista_bytes
        el resto_ es cociente de resto_ entre 128
    fin
    añade resto_ a lista_bytes
    devuelve lista_bytes
fin

define varint_valor de datos:
    el total es 0
    el multiplicador es 1
    para cada b en datos:
        el bajo7 es resto de b entre 128
        el total es (total + (bajo7 * multiplicador))
        el multiplicador es (multiplicador * 128)
    fin
    devuelve total
fin

define zigzag_de de un n:
    si n es mayor que -1:
        devuelve (n * 2)
    fin
    devuelve (((0 - n) * 2) - 1)
fin

define zigzag_a de un z:
    si resto de z entre 2 es 0:
        devuelve cociente de z entre 2
    fin
    devuelve (0 - (cociente de (z + 1) entre 2))
fin

# --- Mensajes: campos con número (tag) y tipo, no solo primitivos sueltos ---

un resultado_varint tiene:
    un valor
    un siguiente
fin

# Como varint_valor, pero lee desde una posición dentro de una lista más
# grande (un mensaje con varios campos) y dice dónde se quedó.
define lee_varint de datos, un indice_inicio:
    el total es 0
    el multiplicador es 1
    el i es indice_inicio
    el continua es verdadero
    mientras continua:
        el octeto es elemento i de datos
        el bajo7 es resto de octeto entre 128
        el total es (total + (bajo7 * multiplicador))
        el multiplicador es (multiplicador * 128)
        si octeto es menor que 128:
            el continua es falso
        fin
        el i es (i + 1)
    fin
    devuelve un nuevo resultado_varint con el valor total, el siguiente i
fin

define tag_campo de un numero_campo, un tipo_alambre:
    devuelve ((numero_campo * 8) + tipo_alambre)
fin

# tipo de alambre 2 (length-delimited): para texto, bytes o mensajes.
define codifica_campo_texto de un numero_campo, un texto:
    los datos son bytes de texto
    los tag son varint_bytes de (tag_campo de numero_campo, 2)
    los long son varint_bytes de (cantidad de datos)
    la resultado son tag
    para cada b en long:
        añade b a resultado
    fin
    para cada b en datos:
        añade b a resultado
    fin
    devuelve resultado
fin

# tipo de alambre 0 (varint): para enteros.
define codifica_campo_entero de un numero_campo, un valor:
    los tag son varint_bytes de (tag_campo de numero_campo, 0)
    los val son varint_bytes de valor
    la resultado son tag
    para cada b en val:
        añade b a resultado
    fin
    devuelve resultado
fin

# Las listas se comparten por referencia, no se copian: "la b son a" hace
# que b y a sean la MISMA lista (añadir a una añade a la otra). Por eso
# esto construye una lista NUEVA en vez de partir de "la resultado son
# lista1".
define concatena de lista1, lista2:
    la resultado son []
    para cada x en lista1:
        añade x a resultado
    fin
    para cada x en lista2:
        añade x a resultado
    fin
    devuelve resultado
fin

un campo_pb tiene:
    un numero
    un tipo
    un valor_varint
    un valor_bytes
    un siguiente
fin

# Lee UN campo (tag + valor) desde una posición del mensaje. Cubre tipo 0
# (varint) y tipo 2 (length-delimited: texto/bytes/mensaje anidado) — no
# cubre fixed32/fixed64 (campos float/double), ver anlaco-lang#8.
define lee_campo_pb de datos, un indice_inicio:
    el r_tag es lee_varint de datos, indice_inicio
    el tag es r_tag.valor
    el numero es cociente de tag entre 8
    el tipo es resto de tag entre 8
    si tipo es 0:
        el r_val es lee_varint de datos, r_tag.siguiente
        devuelve un nuevo campo_pb con el numero numero, el tipo 0, el valor_varint r_val.valor, el valor_bytes nada, el siguiente r_val.siguiente
    fin
    el r_long es lee_varint de datos, r_tag.siguiente
    la longitud es r_long.valor
    el inicio es r_long.siguiente
    los contenido son []
    el i es 0
    mientras i es menor que longitud:
        añade (elemento (inicio + i) de datos) a contenido
        el i es (i + 1)
    fin
    devuelve un nuevo campo_pb con el numero numero, el tipo 2, el valor_varint nada, el valor_bytes contenido, el siguiente (inicio + longitud)
fin
