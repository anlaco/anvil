# idioma: es
# Servidor mínimo: recibe el preface de conexión de HTTP/2, manda su
# propio SETTINGS, recibe el SETTINGS del cliente, contesta con un ACK.
# Primer spike que toca un socket TCP real (ver cliente_handshake.ana,
# que es el otro extremo — correr los dos como procesos separados).

usa "http2"

la preface son [80, 82, 73, 32, 42, 32, 72, 84, 84, 80, 47, 50, 46, 48, 13, 10, 13, 10, 83, 77, 13, 10, 13, 10]

define coincide de un recibido, un esperado:
    si (cantidad de recibido) no es (cantidad de esperado):
        devuelve falso
    fin
    la total es cantidad de esperado
    el i es 1
    el iguales es verdadero
    mientras i es menor que (total + 1):
        el a1 es elemento i de recibido
        el b1 es elemento i de esperado
        si a1 no es b1:
            el iguales es falso
        fin
        el i es (i + 1)
    fin
    devuelve iguales
fin

el servidor es la escucha del puerto 9099
si servidor es nada:
    detente con "no se pudo escuchar"
fin
escribe "servidor escuchando en 9099"

la conexion es la aceptación de servidor
si conexion es nada:
    detente con "no se pudo aceptar"
fin
escribe "cliente conectado"

los recibido_preface son bytes recibidos de conexion
la preface_ok es coincide de recibido_preface, preface
escribe "preface coincide: {preface_ok}"

la cab_settings son http2.cabecera_frame de 0, 4, 0, 0
envía cab_settings a conexion
escribe "SETTINGS del servidor enviado"

los recibido_settings son bytes recibidos de conexion
el tipo_recibido es elemento 4 de recibido_settings
escribe "tipo de frame recibido del cliente: {tipo_recibido}"

la cab_ack son http2.cabecera_frame de 0, 4, 1, 0
envía cab_ack a conexion
escribe "ACK enviado"

cierra conexion
cierra servidor
escribe "servidor cerrado"
