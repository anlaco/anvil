# idioma: es
# Los 225 bytes de abajo NO son un ejemplo inventado: son el bloque de
# cabeceras HPACK exacto que mandó un cliente gRPC real (grpc-python
# 1.82.1, sobre grpc-c 55.0.0) al invocar el servicio Saludador de
# ../prueba_interop/saludador.proto. Se capturaron el 2026-07-22 con
# ../prueba_interop/captura_cruda.py y se pegaron aquí tal cual.
#
# El cliente real usa "Literal Header Field with Incremental Indexing"
# (prefijo de 6 bits) para casi todo, no la forma "without indexing" que
# hpack.ana produce al codificar — este ejemplo demuestra que
# decodifica_campo entiende igual las dos.

usa "grpc/hpack"

la datos son [64, 5, 58, 112, 97, 116, 104, 17, 47, 83, 97, 108, 117, 100, 97, 100, 111, 114, 47, 83, 97, 108, 117, 100, 97, 64, 10, 58, 97, 117, 116, 104, 111, 114, 105, 116, 121, 14, 49, 50, 55, 46, 48, 46, 48, 46, 49, 58, 57, 48, 57, 57, 131, 134, 64, 12, 99, 111, 110, 116, 101, 110, 116, 45, 116, 121, 112, 101, 16, 97, 112, 112, 108, 105, 99, 97, 116, 105, 111, 110, 47, 103, 114, 112, 99, 64, 2, 116, 101, 8, 116, 114, 97, 105, 108, 101, 114, 115, 64, 20, 103, 114, 112, 99, 45, 97, 99, 99, 101, 112, 116, 45, 101, 110, 99, 111, 100, 105, 110, 103, 23, 105, 100, 101, 110, 116, 105, 116, 121, 44, 32, 100, 101, 102, 108, 97, 116, 101, 44, 32, 103, 122, 105, 112, 64, 12, 103, 114, 112, 99, 45, 116, 105, 109, 101, 111, 117, 116, 5, 49, 57, 55, 48, 109, 64, 10, 117, 115, 101, 114, 45, 97, 103, 101, 110, 116, 48, 103, 114, 112, 99, 45, 112, 121, 116, 104, 111, 110, 47, 49, 46, 56, 50, 46, 49, 32, 103, 114, 112, 99, 45, 99, 47, 53, 53, 46, 48, 46, 48, 32, 40, 108, 105, 110, 117, 120, 59, 32, 99, 104, 116, 116, 112, 50, 41]

el pos es 1
la total es cantidad de datos
mientras pos es menor que (total + 1):
    el campo es hpack.decodifica_campo de datos, pos
    escribe "{campo.nombre} = {campo.valor}"
    el pos es campo.siguiente
fin
