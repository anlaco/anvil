# idioma: es
# Codifica "www.example.com" con Huffman y compara contra el vector de
# prueba oficial del RFC 7541 (Apéndice C.4.1): debe dar exactamente
# [241, 227, 194, 229, 242, 58, 107, 160, 171, 144, 244, 255]
# (hex f1e3c2e5f23a6ba0ab90f4ff).

usa "grpc/huffman"

el codificado son huffman.codifica de "www.example.com"
escribe codificado

el decodificado son huffman.decodifica de codificado
escribe decodificado

para cada texto en ["application/grpc", "hola", "GET", "/paquete.Servicio/Metodo"]:
    el cod son huffman.codifica de texto
    el dec son huffman.decodifica de cod
    el original son bytes de texto
    escribe "{texto}: {cantidad de cod} bytes comprimido, {cantidad de original} bytes original"
fin
