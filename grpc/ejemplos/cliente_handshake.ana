# idioma: es
# Otro extremo de servidor_handshake.ana — correr los dos como procesos
# separados, desde la raíz del repo (el servidor primero, este después):
#   bin/anac ejecutar grpc/ejemplos/servidor_handshake.ana &
#   bin/anac ejecutar grpc/ejemplos/cliente_handshake.ana

usa "grpc/http2"

la preface son [80, 82, 73, 32, 42, 32, 72, 84, 84, 80, 47, 50, 46, 48, 13, 10, 13, 10, 83, 77, 13, 10, 13, 10]

define conecta_con_reintentos de un intentos_max:
    el intento es 0
    el conexion_final es nada
    mientras intento es menor que intentos_max y conexion_final es nada:
        la c es la conexión a "127.0.0.1" en el puerto 9099
        si c no es nada:
            el conexion_final es c
        fin
        el intento es (intento + 1)
    fin
    devuelve conexion_final
fin

la conexion es conecta_con_reintentos de 500
si conexion es nada:
    detente con "no se pudo conectar tras reintentos"
fin
escribe "conectado al servidor"

envía preface a conexion
escribe "preface enviado"

la cab_settings son http2.cabecera_frame de 0, 4, 0, 0
envía cab_settings a conexion
escribe "SETTINGS del cliente enviado"

los recibido_settings son bytes recibidos de conexion
el tipo1 es elemento 4 de recibido_settings
escribe "tipo de frame recibido del servidor: {tipo1}"

los recibido_ack son bytes recibidos de conexion
el marca1 es elemento 5 de recibido_ack
escribe "marca del segundo frame recibido: {marca1}"

cierra conexion
