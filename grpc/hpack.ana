# idioma: es
#
# HPACK (RFC 7541) — tabla estática completa + Huffman (ver huffman.ana).
# No hay tabla dinámica: todo se codifica como "Literal Header Field
# without Indexing", que no la toca. Un decodificador HPACK real debe
# aceptar esto sin problema por el estándar, pero decodificar ESTE módulo
# solo entiende lo que él mismo produce (Indexed Header Field y Literal
# without Indexing) — no decodifica las otras dos formas de literal
# (incremental indexing, never indexed). Ver README.md.

usa "huffman"

un entrada_estatica tiene:
    un nombre
    un valor
fin

la tabla_estatica son []
añade un nuevo entrada_estatica con el nombre ":authority", el valor nada a tabla_estatica
añade un nuevo entrada_estatica con el nombre ":method", el valor "GET" a tabla_estatica
añade un nuevo entrada_estatica con el nombre ":method", el valor "POST" a tabla_estatica
