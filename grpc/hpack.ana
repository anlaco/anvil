define busca_estatica de un nombre, un valor:
    el i es 1
    mientras i es menor que 62:
        la e es elemento i de tabla_estatica
        si e.nombre es nombre:
            si e.valor no es nada:
                si e.valor es valor:
                    devuelve i
                fin
            fin
        fin
        el i es (i + 1)
    fin
    devuelve nada
fin

define busca_estatica_nombre de un nombre:
    el i es 1
    mientras i es menor que 62:
        la e es elemento i de tabla_estatica
        si e.nombre es nombre:
            devuelve i
        fin
        el i es (i + 1)
    fin
    devuelve nada
fin

# Codificación de enteros con prefijo (RFC 7541 §5.1). "mascara" es
# 2^bits_prefijo - 1 (127 para prefijo de 7 bits, 15 para 4 bits).
# "patron" son los bits fijos de la representación (128 para Indexed
# Header Field, 0 para Literal Header Field without Indexing).
define codifica_entero de un valor, una mascara, un patron:
    la lista_bytes son []
    si valor es menor que mascara:
        añade (patron + valor) a lista_bytes
        devuelve lista_bytes
    fin
    añade (patron + mascara) a lista_bytes
    el resto_ es (valor - mascara)
    mientras resto_ es mayor que 127:
        el octeto es ((resto de resto_ entre 128) + 128)
        añade octeto a lista_bytes
        el resto_ es cociente de resto_ entre 128
    fin
    añade resto_ a lista_bytes
    devuelve lista_bytes
fin

un resultado_entero tiene:
    un valor
    un siguiente
fin

define decodifica_entero de datos, un indice_inicio, una mascara:
    el primer es elemento indice_inicio de datos
    el limite es (mascara + 1)
    el prefijo es resto de primer entre limite
    si prefijo es menor que mascara:
        devuelve un nuevo resultado_entero con el valor prefijo, el siguiente (indice_inicio + 1)
    fin
    el total es mascara
    el multiplicador es 1
    el i es (indice_inicio + 1)
    el continua es verdadero
    mientras continua:
        el octeto es elemento i de datos
        el bajo7 es resto de octeto entre 128
        el total es (total + (bajo7 * multiplicador))
        el multiplicador es (multiplicador * 128)
        si octeto es menor que 128:
            el continua es falso
        fin
        el i es (i + 1)
    fin
    devuelve un nuevo resultado_entero con el valor total, el siguiente i
fin

# Cadena literal: entero de longitud (con el bit H en el patrón) + bytes.
# Usa Huffman cuando comprime (lo normal), igual que un codificador real —
# si no comprime, va sin comprimir. El bit H (patrón 128 vs 0 en el
# prefijo de longitud) le dice al decodificador cuál de los dos es.
define codifica_cadena de un texto:
    los plano son bytes de texto
    los comprimido son huffman.codifica de texto
    la usar_huffman es falso
    si (cantidad de comprimido) es menor que (cantidad de plano):
        la usar_huffman es verdadero
    fin
    si usar_huffman:
        la resultado son codifica_entero de (cantidad de comprimido), 127, 128
        para cada b en comprimido:
            añade b a resultado
        fin
        devuelve resultado
    fin
    la resultado son codifica_entero de (cantidad de plano), 127, 0
    para cada b en plano:
        añade b a resultado
    fin
    devuelve resultado
fin

un resultado_cadena tiene:
    un bytes_
    un siguiente
fin

# Devuelve el contenido como LISTA DE BYTES, no como texto: Ana no tiene
# hoy conversión de bytes a texto (reportado, ver anlaco-lang#6).
define decodifica_cadena de datos, un indice_inicio:
    el primer es elemento indice_inicio de datos
    el h_bit es cociente de primer entre 128
    el r_long es decodifica_entero de datos, indice_inicio, 127
    el longitud es r_long.valor
    el inicio_datos es r_long.siguiente
    los crudos son []
    el i es 0
    mientras i es menor que longitud:
        el pos es (inicio_datos + i)
        añade (elemento pos de datos) a crudos
        el i es (i + 1)
    fin
    el siguiente_indice es (inicio_datos + longitud)
    si h_bit es 1:
        los contenido son huffman.decodifica de crudos
        devuelve un nuevo resultado_cadena con el bytes_ contenido, el siguiente siguiente_indice
    fin
    devuelve un nuevo resultado_cadena con el bytes_ crudos, el siguiente siguiente_indice
fin

# Codifica un campo de cabecera (nombre, valor — ambos texto Ana):
# Indexed Header Field si nombre+valor coinciden exactos en la tabla
# estática; si no, Literal without Indexing (con nombre indexado si el
# nombre solo ya está en la tabla, o con nombre y valor literales).
define codifica_campo de un nombre, un valor:
    el idx_exacto es busca_estatica de nombre, valor
    si idx_exacto no es nada:
        devuelve codifica_entero de idx_exacto, 127, 128
    fin
    el idx_nombre es busca_estatica_nombre de nombre
    si idx_nombre no es nada:
        la cab son codifica_entero de idx_nombre, 15, 0
        los val_bytes son codifica_cadena de valor
        para cada b en val_bytes:
            añade b a cab
        fin
        devuelve cab
    fin
    la cab son codifica_entero de 0, 15, 0
    los nom_bytes son codifica_cadena de nombre
    para cada b en nom_bytes:
        añade b a cab
    fin
    los val_bytes son codifica_cadena de valor
    para cada b en val_bytes:
        añade b a cab
    fin
    devuelve cab
fin

un campo_decodificado tiene:
    un nombre
    un valor
    un siguiente
fin

# El nombre viene como texto Ana si salió de la tabla estática (Indexed
# Header Field o nombre indexado), o como lista de bytes si vino literal
# (nombre nuevo) — misma limitación que decodifica_cadena. El valor
# SIEMPRE es lista de bytes salvo en Indexed Header Field, donde viene de
# la tabla ya como texto.
define decodifica_campo de datos, un indice_inicio:
    el primer es elemento indice_inicio de datos
    si primer es mayor que 127:
        el r_idx es decodifica_entero de datos, indice_inicio, 127
        el idx_tabla es r_idx.valor
        la entrada es elemento idx_tabla de tabla_estatica
        devuelve un nuevo campo_decodificado con el nombre entrada.nombre, el valor entrada.valor, el siguiente r_idx.siguiente
    fin
    el r_idx es decodifica_entero de datos, indice_inicio, 15
    el idx es r_idx.valor
    el pos es r_idx.siguiente
    si idx es 0:
        el r_nombre es decodifica_cadena de datos, pos
        el r_valor es decodifica_cadena de datos, r_nombre.siguiente
        devuelve un nuevo campo_decodificado con el nombre r_nombre.bytes_, el valor r_valor.bytes_, el siguiente r_valor.siguiente
    fin
    la entrada es elemento idx de tabla_estatica
    el r_valor es decodifica_cadena de datos, pos
    devuelve un nuevo campo_decodificado con el nombre entrada.nombre, el valor r_valor.bytes_, el siguiente r_valor.siguiente
fin
