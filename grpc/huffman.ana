define busca_simbolo de un simbolo:
    para cada e en tabla_huffman:
        si e.simbolo es simbolo:
            devuelve e
        fin
    fin
    devuelve nada
fin

define busca_codigo de un candidato, un longitud:
    para cada e en tabla_huffman:
        si e.bits es longitud:
            si e.codigo es candidato:
                devuelve e
            fin
        fin
    fin
    devuelve nada
fin

# Codifica un texto Ana a bytes Huffman-comprimidos, con el relleno final
# de unos que exige el estándar.
define codifica de un texto:
    los datos_orig son bytes de texto
    la salida son []
    el buffer_valor es 0
    el buffer_bits es 0
    para cada s en datos_orig:
        la entrada es busca_simbolo de s
        el pot_codigo es potencia_de_2 de entrada.bits
        el buffer_valor es ((buffer_valor * pot_codigo) + entrada.codigo)
        el buffer_bits es (buffer_bits + entrada.bits)
        mientras buffer_bits es mayor que 7:
            el extra es (buffer_bits - 8)
            el pot_extra es potencia_de_2 de extra
            el byte_arriba es cociente de buffer_valor entre pot_extra
            el buffer_valor es resto de buffer_valor entre pot_extra
            el buffer_bits es extra
            añade byte_arriba a salida
        fin
    fin
    si buffer_bits es mayor que 0:
        el bits_faltan es (8 - buffer_bits)
        el pot_faltan es potencia_de_2 de bits_faltan
        el relleno es (pot_faltan - 1)
        el byte_final es ((buffer_valor * pot_faltan) + relleno)
        añade byte_final a salida
    fin
    devuelve salida
fin

# Decodifica bytes Huffman-comprimidos a una lista de bytes (0-255). No
# hace falta saber cuántos símbolos hay de antemano: para en cuanto
# quedan menos de 5 bits, o cuando los bits que quedan no forman ningún
# código válido (relleno final de unos).
define decodifica de datos:
    la salida son []
    el total_bits es ((cantidad de datos) * 8)
    el pos es 0
    el continua es verdadero
    mientras continua:
        si (total_bits - pos) es menor que 5:
            el continua es falso
        fin
        si continua:
            el candidato es 0
            el l es 0
            el encontrado es nada
            mientras l es menor que 30 y (pos + l) es menor que total_bits:
                el b es bit_en de datos, (pos + l)
                el candidato es ((candidato * 2) + b)
                el l es (l + 1)
                si l es mayor que 4:
                    el e es busca_codigo de candidato, l
                    si e no es nada:
                        el encontrado es e
                        el l es 30
                    fin
                fin
            fin
            si encontrado es nada:
                el continua es falso
            fin
            si encontrado no es nada:
                añade encontrado.simbolo a salida
                el pos es (pos + encontrado.bits)
            fin
        fin
    fin
    devuelve salida
fin
