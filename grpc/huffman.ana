# idioma: es
#
# Huffman de HPACK (RFC 7541 Apéndice B) — 257 símbolos (0-255 más EOS=256).
# Tabla verificada: sin colisiones de prefijo entre los 257 códigos (se
# comprobó por separado antes de escribir esto), y el resultado de
# codificar "www.example.com" coincide byte a byte con el ejemplo oficial
# del RFC (Apéndice C.4): f1e3c2e5f23a6ba0ab90f4ff.

define potencia_de_2 de un exponente:
    el resultado es 1
    el i es 0
    mientras i es menor que exponente:
        el resultado es (resultado * 2)
        el i es (i + 1)
    fin
    devuelve resultado
fin

define bit_en de datos, un posicion_bit:
    el idx_byte es ((cociente de posicion_bit entre 8) + 1)
    el offset es resto de posicion_bit entre 8
    el byte_val es elemento idx_byte de datos
    el despl es (7 - offset)
    el pot es potencia_de_2 de despl
    devuelve resto de (cociente de byte_val entre pot) entre 2
fin

un huffman_entrada tiene:
    un simbolo
    un codigo
    un bits
fin

la tabla_huffman son []
