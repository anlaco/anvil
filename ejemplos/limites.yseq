# Limit test + action, meant to run with the limits sidecar
# `limites.limits.yaml` (property loader, RF-30).
#
# Without the sidecar: demo/measure_voltage reads 4.2 V against the 4.5–5.5
# range written here and the engine declares it a fail (Main stops there). With
# the sidecar, the limit becomes a comparison (>= 4.0): 4.2 meets it and the
# sequence passes. Changing the verdict without touching the sequence is the
# value of the property loader.
#
#   ./anvil ejemplos/limites.yseq --limits ejemplos/limites.limits.yaml

name: limites
executors:
  - { name: demo, type: grpc, host: 127.0.0.1, port: 9101 }
setup:
  - name: demo/open_relay        # action (RF-27): technical success, no measurement
    type: action
    module: demo/open_relay
    executor: demo
    retries: 1
  - name: demo/connect
    type: action
    module: demo/connect
    executor: demo
    retries: 3
main:
  - name: demo/measure_voltage   # limit test (RF-26): the engine evaluates the range
    type: numeric_limit
    module: demo/measure_voltage
    executor: demo
    retries: 1
    limit:
      comparison: GELE
      low: 4.5
      high: 5.5
  - name: demo/check_led         # pass/fail (RF-25)
    type: pass_fail
    module: demo/check_led
    executor: demo
    retries: 1
cleanup:
  - name: demo/disconnect
    type: action
    module: demo/disconnect
    executor: demo
    retries: 1

# ADR-0046: opcional, y el motor la ignora. Dice cómo levantar ese ejecutor
# en tu máquina para diseñar y depurar; en producción este bloque no está.
dev:
  demo:
    runtime: wasm
    code: departamento/dist
