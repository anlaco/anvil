# A WASM executor serving **several modules** (ADR-0025).
#
# The executor is not the `.wasm` any more: it is a department with a working
# directory, and each `.wasm` inside is a module. A step is named
# `<module>/<step>`, where the module's logical name is the file stem — the
# extension and the path never appear here, so the department can reorganise
# its folders, or rewrite a module in another language, without editing this
# file.
#
# Assemble the department (`make build` does it; this is what it does):
#   cargo build --target wasm32-wasip2 --manifest-path ejemplos/departamento/Cargo.toml
#   cp executors/wasm/target/debug/anvil-exec-wasm ejemplos/departamento/dist/
#   cp ejemplos/departamento/target/wasm32-wasip2/debug/*.wasm ejemplos/departamento/dist/
#
# Run (from the repo root):
#   ./packaging/anvil-host/target/release/anvil ejemplos/demo_departamento.yseq
#
# See what the department serves, without running anything:
#   ./ejemplos/departamento/dist/anvil-exec-wasm --list

name: demo_departamento
executors:
  # An executor is an address (ADR-0046). What technology serves it, where its
  # modules live and how it was started are not this file's business — which is
  # why rewriting the department from WASM to Python would not change a line
  # here.
  - name: instrumentos
    type: grpc
    host: 127.0.0.1
    port: 9101

main:
  # Two modules, the same step name, two different instruments. This is the
  # collision the qualified name exists to resolve: without the module prefix
  # there would be no way to say which of the two measures.
  - name: multimetro/medir_voltaje
    type: numeric_limit
    module: multimetro/medir_voltaje
    executor: instrumentos
    retries: 1
    inputs:
      canal: 3
    limit:
      comparison: GELE
      low: 4.0
      high: 5.0

  - name: plc/medir_voltaje
    type: numeric_limit
    module: plc/medir_voltaje
    executor: instrumentos
    retries: 1
    limit:
      comparison: GELE
      low: 23.0
      high: 25.0

# ADR-0046: opcional, y el motor la ignora. Dice cómo levantar ese ejecutor
# en tu máquina para diseñar y depurar; en producción este bloque no está.
dev:
  instrumentos:
    runtime: wasm
    code: departamento/dist
