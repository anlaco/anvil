# Composite verdict with `type: pass_fail` (RF-25, ADR-0018).
#
# The acceptance criterion that combines SEVERAL measurements, which is what a
# test engineer writes at the end of a sequence. Until ADR-0018 there was no
# way to express it: a `statement` only assigns, so the verdict ended up in a
# local nobody read again and the sequence came out green anyway (DIAG-2 of the
# beta report: 131 of 180 sequences ended that way).
#
# Anvil's three ways of failing, together and in order:
#   1. the STEP decides               → demo/check_led (classic pass/fail, RF-25)
#   2. the ENGINE evaluates the LIMIT → demo/measure_voltage (RF-29, ADR-0008)
#   3. the ENGINE evaluates the CONDITION over variables → verificar_dut (ADR-0018)
#
# Run:
#   ./anvil ejemplos/veredicto.yseq
#
# Expected result: demo/measure_voltage reads 4.2, inside its loose limit
# (4.0–6.0) → `pass`; but the product's real criterion is narrower (4.9–5.1),
# so `verificar_dut` declares it `fail` and Main stops:
#   === veredicto: fail ===
#     [done] demo/open_relay: relay open
#     [pass] demo/measure_voltage: measured: 4.2 V (channel 1)
#     [pass] demo/check_led: led on
#     [fail] verificar_dut: condición no cumplida
#     [done] demo/disconnect: instrument disconnected
# `demo/disconnect` does run: Cleanup always runs.
#
# Try relaxing the condition to `locals.voltaje > 4.0 && locals.led_ok` and you
# will see the whole sequence pass.

name: veredicto

executors:
  - { name: demo, type: wasm, path: departamento/dist/anvil-exec-wasm }

# The verdict is evaluated over variables, so they have to be dumped first
# with `assign`. They must be declared (the loader requires it).
locals:
  voltaje: 0.0
  led_ok: false

setup:
  - name: demo/open_relay
    type: action
    module: demo/open_relay
    executor: demo
    retries: 1

main:
  # (2) Loose limit: the engine evaluates it and it passes. It is the "is it
  # alive", not the product criterion.
  - name: demo/measure_voltage
    type: numeric_limit
    module: demo/measure_voltage
    executor: demo
    retries: 1
    limit:
      comparison: GELE
      low: 4.0
      high: 6.0
    assign:
      voltaje: '${result.measured_value}'

  # (1) Classic pass/fail: the step decides, with no measurement.
  - name: demo/check_led
    type: pass_fail
    module: demo/check_led
    executor: demo
    retries: 1
    assign:
      led_ok: '${result.status == "pass"}'

  # (3) The composite verdict: combines the two measurements above. The engine
  # evaluates it; the step takes no part. `false` → fail, and Main stops here.
  # It does not accept `retries > 1`: it evaluates a pure expression, the
  # result would not change between attempts.
  - name: verificar_dut
    type: pass_fail
    condition: 'locals.voltaje > 4.9 && locals.voltaje < 5.1 && locals.led_ok'

cleanup:
  - name: demo/disconnect
    type: action
    module: demo/disconnect
    executor: demo
    retries: 1
