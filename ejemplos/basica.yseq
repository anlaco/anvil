# The basic example: setup, main and cleanup against the demo bench.
#
# The steps are served by `demo`, a WASM component in the example department,
# which `anvil-exec-wasm` serves from next to its own binary (ADR-0025,
# ADR-0041). Nothing else needs to be installed or started.
#
# `demo/measure_voltage` reads 4.2 V and the threshold lives here, not in the
# step: the engine judges the reading against the 4.5–5.5 range (ADR-0008), so
# this sequence fails on purpose.
#
#   === basica: fail ===
#     [done] demo/connect: instrument connected (attempt 2)
#     [fail] demo/measure_voltage: 4.2 fuera de rango [4.5, 5.5]
#     [done] demo/disconnect: instrument disconnected

name: basica
executors:
  - { name: demo, type: grpc, host: 127.0.0.1, port: 9101 }
setup:
  - name: demo/connect
    type: action
    module: demo/connect
    executor: demo
    retries: 3
main:
  - name: demo/measure_voltage
    type: numeric_limit
    module: demo/measure_voltage
    executor: demo
    retries: 1
    # `comment` is TestStand's Comment, on the General page of a step's
    # properties: free text for whoever reads the sequence. The engine never
    # reads it and no verdict depends on it.
    comment: |
      The 4.5-5.5 V window is the one on the drawing. The bench reads 4.2 V,
      so this step fails on purpose — that is what this example is for.
    limit:
      comparison: GELE
      low: 4.5
      high: 5.5
  - name: demo/check_led
    type: pass_fail
    module: demo/check_led
    executor: demo
    retries: 1
cleanup:
  - name: demo/disconnect
    type: action
    module: demo/disconnect
    executor: demo
    retries: 1

# ADR-0046: opcional, y el motor la ignora. Dice cómo levantar ese ejecutor
# en tu máquina para diseñar y depurar; en producción este bloque no está.
dev:
  demo:
    runtime: wasm
    code: departamento/dist
