# External subsequence (M4b): a public sequence reusable by path.
# `subsecuencia.yseq` calls it with `sequence: ./medir_fuentes.yseq`.
#
# Shows input/output Parameters by reference (as in TestStand):
#   - It receives `canal` from the parent when it starts.
#   - It mutates it (`parameters.canal = parameters.canal + 1.0`) with a statement.
#   - On return, the engine copies `parameters.canal` (final) to the parent's
#     `locals.canal_in` (the same lvalue as the input).
#
# It declares no `executors:`: a subsequence file cannot, and `demo` is the
# executor of the sequence that calls it.
name: medir_fuentes
parameters:
  canal: 0.0
main:
  - name: ajustar_canal
    type: statement
    statement: 'parameters.canal = parameters.canal + 1.0'
  - name: demo/measure_voltage
    module: demo/measure_voltage
    type: numeric_limit
    executor: demo
    retries: 1
    limit:
      comparison: GELE
      low: 4.0
      high: 5.0
cleanup:
  - name: demo/disconnect
    module: demo/disconnect
    type: action
    executor: demo
    retries: 1
