# A sequence with subsequences (M4b). Shows BOTH routes of a sequence call:
#
# 1. **Inline** (`init_comun`): declared under `subsequences:`, called by
#    name (`sequence: init_comun`). Private to this file. Only this sequence
#    uses it, so it stays inside.
# 2. **External** (`./medir_fuentes.yseq`): in a separate file, called by
#    path. Reusable by other sequences.
#
# Both pass `args` by reference: each argument is the parent's `locals.X` ↔ the
# subsequence's `parameters.P` (input when it starts, output on return). The
# second call's `assign` dumps the call's aggregate status (`result.status`)
# into `locals.estado_fuentes`.
#
# `executors:` is declared here, in the root: the external subsequence's steps
# use `demo` too, and a subsequence file declares no executors of its own.
name: basica
executors:
  - { name: demo, type: grpc, host: 127.0.0.1, port: 9101 }
locals:
  canal_in: 0.5
  ok_init: false
  estado_fuentes: ""
subsequences:
  init_comun:                       # inline, by name; takes the key as its name
    parameters:
      canal: 0.0
      listo: false
    main:
      - name: preparar_canal
        type: statement
        statement: 'parameters.listo = (parameters.canal >= 0.0)'
main:
  - name: preparar
    type: sequence_call
    sequence: init_comun              # name → inline
    args: { canal: locals.canal_in, listo: locals.ok_init }
    # on return: locals.ok_init = parameters.listo (final, true)
  - name: test_fuentes
    type: sequence_call
    sequence: ./medir_fuentes.yseq    # path → external file
    args: { canal: locals.canal_in }
    assign: { estado_fuentes: "${result.status}" }
    # on return: locals.canal_in = parameters.canal (final, mutated to 1.5)

# ADR-0046: opcional, y el motor la ignora. Dice cómo levantar ese ejecutor
# en tu máquina para diseñar y depurar; en producción este bloque no está.
dev:
  demo:
    runtime: wasm
    code: departamento/dist
