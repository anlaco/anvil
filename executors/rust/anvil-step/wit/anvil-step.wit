// Copyright 2026 ANLACO
//
// The version lives in the package name and travels with the artifact:
// wasmtime refuses to instantiate a component that does not match. **There is
// no compatibility shim in the bridge: the rule is to recompile**
// (ADR-0020 §4d). 0.4.0 is the first time that bill has been paid: `describe`
// was added so a component can publish its catalog (ADR-0024, issue #39), and
// every component built against 0.3.0 has to be rebuilt. The bridge is the
// only translator, and therefore the only one that knows which contract
// number goes with which WIT version — so it is the bridge that answers the
// gRPC echo. A component knows nothing about gRPC, protobuf or contract
// versions (ADR-0015).
package anvil:step@0.4.0;

interface step {
  /// A typed value crossing the component boundary. The three types are the
  /// same as the `oneof Value` of `paso.proto` and of `expr::Value`: no lists
  /// and no maps (a parameter that needs structure is a badly cut step,
  /// ADR-0020 §2).
  variant value {
    number(f64),
    text(string),
    boolean(bool),
  }

  /// A `value` with its name. Named rather than positional: sequences are
  /// written and reviewed by hand, and reordering two parameters must not
  /// change what the bench measures.
  record named {
    name: string,
    value: value,
  }

  /// `step-result` y no `result`: `result` es palabra reservada de WIT. Es
  /// una concesión al lenguaje, no al idioma — igual que `type` en Rust.
  record step-result {
    /// The step's verdict. It is text because that is how it travels in
    /// `paso.proto` and a step may be written in any language, but the
    /// vocabulary is **closed**: exactly one of these four literals, lowercase.
    ///
    ///   "pass"     the step met its criterion
    ///   "fail"     the unit does not comply — information about the DUT
    ///   "error"    could not be judged — information about the bench or step
    ///   "skipped"  did not run (set by the engine; a step never returns it)
    ///
    /// Any other string —"Pass", "PASS", "ok", and also "inconclusive", which
    /// only the engine produces when aggregating— turns the step into "error",
    /// with a message naming the value received. A status Anvil cannot read
    /// says nothing about the unit (ADR-0019, Rule 2).
    status: string,
    /// Free text for the report: what the step did, or why it could not.
    message: string,
    /// The measurement, if the step measures. The **threshold does not belong
    /// to the step**: the engine evaluates the `limit` declared in the
    /// sequence against it (ADR-0008).
    measured-value: option<f64>,
    /// Named values the step returns **besides** the measurement: a context
    /// temperature, a serial number read off the unit, a coefficient. They
    /// take no part in the verdict; `assign` reads them as
    /// `result.outputs.<name>` (ADR-0020 §3).
    ///
    /// No `inout`: in through `inputs`, out through `outputs`, and there is no
    /// third path. Giving one would hand the step a reference to the engine's
    /// environment, which is what ADR-0003 and ADR-0005 avoid.
    outputs: list<named>,
  }

  /// `inputs` arrive **already evaluated**: the engine resolves the `${...}`
  /// expressions of the YAML against its environment before calling
  /// (ADR-0009). The step never sees `locals` or `file_globals`; it is handed
  /// values.
  run: func(name: string, attempt: s32, inputs: list<named>) -> step-result;

  /// What a parameter is, for the catalog. The same vocabulary as
  /// `ValueType` of `paso.proto`, minus `reference`: a component cannot hold
  /// an object between calls, and the bridge already rejects a reference that
  /// reaches it (ADR-0022 §8). A type the component does not declare stays
  /// `unspecified`, which Anvil reads as *unchecked* and never as "number"
  /// (ADR-0019, Rule 2).
  enum value-type {
    unspecified,
    number,
    text,
    boolean,
  }

  /// One input of a step, as the catalog describes it.
  record parameter-spec {
    name: string,
    %type: value-type,
    /// Whether the sequence has to send it. An optional one the sequence
    /// omits is the step's business, not an error.
    required: bool,
    /// Declared **for the reader and for the future editor, not for the
    /// engine**: the engine never sends it, the step applies its own
    /// (ADR-0021 §5).
    default: option<value>,
    doc: string,
  }

  /// One named output of a step — what `assign` reads as
  /// `result.outputs.<name>`. Declaring it is what lets Anvil check that
  /// expression without running the sequence (ADR-0020 §3).
  record output-spec {
    name: string,
    %type: value-type,
    doc: string,
  }

  /// One step of the catalog: the name a sequence uses and the shape of the
  /// call.
  record step-spec {
    name: string,
    inputs: list<parameter-spec>,
    outputs: list<output-spec>,
    doc: string,
  }

  /// The catalog: which steps this component serves and what they take.
  ///
  /// It is the second door, and the reason this interface went to 0.4.0. With
  /// only `run` there was no list of names to publish and no signature to
  /// read, so the bridge answered `describes = false` and the steps came out
  /// as *unchecked* under `--validate --with-executors` — a `canall` for
  /// `canal` in the YAML was found with the unit already on the bench
  /// (ADR-0021).
  ///
  /// **An empty list means "do not check me"**, not "I serve nothing". In
  /// gRPC the two are told apart by a boolean because an executor can serve
  /// zero steps on purpose; a component that serves zero steps is a component
  /// with nothing to do, so the safe reading is the only useful one
  /// (ADR-0021 §4). The bridge turns an empty list into `describes = false`.
  ///
  /// Asked **once per component at start-up**, never before each step:
  /// finding out at step 47 that a name is wrong leaves the unit half tested,
  /// and a catalog that changes mid-run makes the report impossible to
  /// reconstruct (ADR-0021 §3).
  describe: func() -> list<step-spec>;
}

world anvil-step {
  export step;
}
