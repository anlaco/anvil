name: wasm

executors:
  - { name: rs, type: grpc, host: 127.0.0.1, port: 9101 }

main:
  - name: board/measure_rail
    type: numeric_limit
    module: board/measure_rail
    executor: rs
    limit: { comparison: GELE, low: 4.75, high: 5.25 }

# ADR-0046: opcional, y el motor la ignora. Dice cómo levantar ese ejecutor
# en tu máquina para diseñar y depurar; en producción este bloque no está.
dev:
  rs:
    runtime: wasm
    code: ../wasm-dept
