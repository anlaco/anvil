# idioma: es
# Servidor gRPC que ejecuta pasos por nombre (el "adaptador" de Ana para
# el motor genérico, ver motor.ana). Corre con el directorio de trabajo
# en la raíz del repo:
#   bin/anac ejecutar secuenciador/rpc/ejecutor_pasos.ana

usa "grpc/http2"
usa "grpc/hpack"
usa "grpc/protobuf"
usa "grpc/conexion"
usa "secuenciador/modelo"
usa "secuenciador/pasos_demo"
usa "secuenciador/rpc/paso_codec"

define despacha de un nombre_bytes, un intento:
    si protobuf.coincide de nombre_bytes, (bytes de "conectar_equipo"):
        devuelve pasos_demo.paso_conectar de intento
    fin
    si protobuf.coincide de nombre_bytes, (bytes de "medir_voltaje"):
        devuelve pasos_demo.paso_medir_voltaje de intento
    fin
    si protobuf.coincide de nombre_bytes, (bytes de "verificar_led"):
        devuelve pasos_demo.paso_verificar_led de intento
    fin
    si protobuf.coincide de nombre_bytes, (bytes de "desconectar_equipo"):
        devuelve pasos_demo.paso_desconectar de intento
    fin
    devuelve un nuevo resultado_step con el nombre "desconocido", el estado "error", el mensaje "paso no reconocido"
fin

define manda_respuesta de enlace, un stream, una r:
    los cuerpo_pb son paso_codec.codifica_resultado_paso de r
    el b0 es cociente de (cantidad de cuerpo_pb) entre 16777216
    el resto0 es resto de (cantidad de cuerpo_pb) entre 16777216
    el b1 es cociente de resto0 entre 65536
    el resto1 es resto de resto0 entre 65536
    el b2 es cociente de resto1 entre 256
    el b3 es resto de resto1 entre 256
    los prefijo son [0, b0, b1, b2, b3]
    los cuerpo_data son protobuf.concatena de prefijo, cuerpo_pb

    los h_status son hpack.codifica_campo de ":status", "200"
    los h_tipo son hpack.codifica_campo de "content-type", "application/grpc"
    los cab_headers son protobuf.concatena de h_status, h_tipo
    la marco_headers son http2.cabecera_frame de (cantidad de cab_headers), 1, 4, stream
    los envio_headers son protobuf.concatena de marco_headers, cab_headers
    envía envio_headers a enlace

    la marco_data son http2.cabecera_frame de (cantidad de cuerpo_data), 0, 0, stream
    los envio_data son protobuf.concatena de marco_data, cuerpo_data
    envía envio_data a enlace

    los h_gstatus son hpack.codifica_campo de "grpc-status", "0"
    la marco_trailers son http2.cabecera_frame de (cantidad de h_gstatus), 1, 5, stream
    los envio_trailers son protobuf.concatena de marco_trailers, h_gstatus
    envía envio_trailers a enlace
fin

el servidor es la escucha del puerto 9100
si servidor es nada:
    detente con "no se pudo escuchar"
fin
escribe "ejecutor de pasos escuchando en 9100"

el enlace es la aceptación de servidor
si enlace es nada:
    detente con "no se pudo aceptar"
fin
escribe "motor conectado"

el r_preface es conexion.lee_n de enlace, [], 24
escribe "preface recibido"

la cab_settings son http2.cabecera_frame de 0, 4, 0, 0
envía cab_settings a enlace

el buffer es r_preface.resto
el sigue_conectado es verdadero
mientras sigue_conectado:
    # ¿sigue el motor ahí, o cerró la conexión? (entre peticiones, no a
    # mitad de un frame — ver conexion.ana)
    si (cantidad de buffer) es 0:
        los mas son bytes recibidos de enlace
        si (cantidad de mas) es 0:
            el sigue_conectado es falso
        fin
        si (cantidad de mas) es mayor que 0:
            para cada b en mas:
                añade b a buffer
            fin
        fin
    fin

    si sigue_conectado:
        la rf es conexion.lee_frame de enlace, buffer
        el buffer es rf.resto

        si rf.tipo es 4:
            si rf.marca es 0:
                la cab_ack son http2.cabecera_frame de 0, 4, 1, 0
                envía cab_ack a enlace
            fin
        fin

        si rf.tipo es 0:
            los datos_msg son rf.payload
            los sin_prefijo son []
            el i es 6
            la total_msg es cantidad de datos_msg
            mientras i es menor que (total_msg + 1):
                añade (elemento i de datos_msg) a sin_prefijo
                el i es (i + 1)
            fin
            los peticion son paso_codec.decodifica_peticion_paso de sin_prefijo
            el nombre_pedido es texto de peticion.nombre_bytes
            escribe "paso pedido: {nombre_pedido} intento={peticion.intento}"
            el r es despacha de peticion.nombre_bytes, peticion.intento
            manda_respuesta de enlace, rf.stream, r
            escribe "respuesta enviada, stream {rf.stream}"
        fin
    fin
fin

cierra enlace
cierra servidor
escribe "ejecutor de pasos cerrado"
