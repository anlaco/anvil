# idioma: es
# Motor genérico de secuencias: lee una definicion_secuencia (datos) y la
# corre invocando cada paso por gRPC contra ejecutor_pasos.ana — nunca
# llama a una función Ana directamente (ver la discusión de por qué:
# aislamiento y uniformidad con pasos que algún día serán Python/DLL).
# Corre con el directorio de trabajo en la raíz del repo.

usa "grpc/http2"
usa "grpc/hpack"
usa "grpc/protobuf"
usa "grpc/conexion"
usa "secuenciador/modelo"
usa "secuenciador/ejecutor"
usa "secuenciador/rpc/paso_codec"

la preface son [80, 82, 73, 32, 42, 32, 72, 84, 84, 80, 47, 50, 46, 48, 13, 10, 13, 10, 83, 77, 13, 10, 13, 10]

un conexion_lista tiene:
    un enlace
    un buffer
fin

define conecta de un host, un puerto:
    la enlace es la conexión a host en el puerto puerto
    si enlace es nada:
        devuelve nada
    fin
    envía preface a enlace
    la cab_settings son http2.cabecera_frame de 0, 4, 0, 0
    envía cab_settings a enlace
    la rf es conexion.lee_frame de enlace, []
    si rf.tipo es 4:
        si rf.marca es 0:
            la ack son http2.cabecera_frame de 0, 4, 1, 0
            envía ack a enlace
        fin
    fin
    devuelve un nuevo conexion_lista con el enlace enlace, el buffer rf.resto
fin

# Como conexion.lee_frame, pero se traga (y contesta ACK si hace falta)
# cualquier SETTINGS que aparezca intercalado — el ACK de nuestro propio
# SETTINGS puede llegar en cualquier momento después del primer paso.
define lee_frame_relevante de enlace, buffer:
    el buffer_actual es buffer
    el encontrado es nada
    mientras encontrado es nada:
        la rf es conexion.lee_frame de enlace, buffer_actual
        el buffer_actual es rf.resto
        si rf.tipo es 4:
            si rf.marca es 0:
                la ack son http2.cabecera_frame de 0, 4, 1, 0
                envía ack a enlace
            fin
        fin
        si rf.tipo no es 4:
            el encontrado es rf
        fin
    fin
    devuelve encontrado
fin

un paso_y_buffer tiene:
    un resultado
    un buffer
fin

define ejecuta_paso_remoto de enlace, buffer, un stream, un nombre, un intento:
    los cuerpo_pb son paso_codec.codifica_peticion_paso de nombre, intento
    el b0 es cociente de (cantidad de cuerpo_pb) entre 16777216
    el resto0 es resto de (cantidad de cuerpo_pb) entre 16777216
    el b1 es cociente de resto0 entre 65536
    el resto1 es resto de resto0 entre 65536
    el b2 es cociente de resto1 entre 256
    el b3 es resto de resto1 entre 256
    los prefijo son [0, b0, b1, b2, b3]
    los cuerpo_data son protobuf.concatena de prefijo, cuerpo_pb

    los h_metodo son hpack.codifica_campo de ":method", "POST"
    los h_esquema son hpack.codifica_campo de ":scheme", "http"
    los h_ruta son hpack.codifica_campo de ":path", "/EjecutorPasos/Invoca"
    los h_tipo son hpack.codifica_campo de "content-type", "application/grpc"
    los h_te son hpack.codifica_campo de "te", "trailers"
    la cab_headers es protobuf.concatena de h_metodo, h_esquema
    la cab_headers es protobuf.concatena de cab_headers, h_ruta
    la cab_headers es protobuf.concatena de cab_headers, h_tipo
    la cab_headers es protobuf.concatena de cab_headers, h_te

    la marco_headers son http2.cabecera_frame de (cantidad de cab_headers), 1, 4, stream
    la envio_headers son protobuf.concatena de marco_headers, cab_headers
    envía envio_headers a enlace

    la marco_data son http2.cabecera_frame de (cantidad de cuerpo_data), 0, 1, stream
    la envio_data son protobuf.concatena de marco_data, cuerpo_data
    envía envio_data a enlace

    la rf_headers es lee_frame_relevante de enlace, buffer
    la rf_data es lee_frame_relevante de enlace, rf_headers.resto
    la rf_trailers es lee_frame_relevante de enlace, rf_data.resto

    los datos_msg son rf_data.payload
    los sin_prefijo son []
    el i es 6
    la total_msg es cantidad de datos_msg
    mientras i es menor que (total_msg + 1):
        añade (elemento i de datos_msg) a sin_prefijo
        el i es (i + 1)
    fin
    la decodificado es paso_codec.decodifica_resultado_paso de sin_prefijo

    el nombre_txt es texto de decodificado.nombre_bytes
    el estado_txt es texto de decodificado.estado_bytes
    el mensaje_txt es texto de decodificado.mensaje_bytes
    el r es un nuevo resultado_step con el nombre nombre_txt, el estado estado_txt, el mensaje mensaje_txt
    devuelve un nuevo paso_y_buffer con el resultado r, el buffer rf_trailers.resto
fin

un paso_y_estado tiene:
    un resultado
    un buffer
    un stream_siguiente
fin

define ejecuta_con_reintentos de enlace, buffer, un stream_inicial, un nombre, un max_intentos:
    el intento es 1
    el stream_actual es stream_inicial
    la pr es ejecuta_paso_remoto de enlace, buffer, stream_actual, nombre, intento
    el res es pr.resultado
    el ok es falso
    si res.estado es "paso":
        el ok es verdadero
    fin
    mientras ok es falso y intento es menor que max_intentos:
        el intento es (intento + 1)
        el stream_actual es (stream_actual + 2)
        la pr es ejecuta_paso_remoto de enlace, pr.buffer, stream_actual, nombre, intento
        el res es pr.resultado
        el ok es falso
        si res.estado es "paso":
            el ok es verdadero
        fin
    fin
    devuelve un nuevo paso_y_estado con el resultado res, el buffer pr.buffer, el stream_siguiente (stream_actual + 2)
fin

define ejecuta_secuencia de enlace, buffer_inicial, un stream_inicial, una definicion:
    el secuencia es un nuevo resultado_secuencia con el nombre definicion.nombre, el pasos []

    el buffer_actual es buffer_inicial
    el stream_actual es stream_inicial
    el setup_ok es verdadero
    para cada p en definicion.pasos_setup:
        la r es ejecuta_con_reintentos de enlace, buffer_actual, stream_actual, p.nombre, p.reintentos
        el buffer_actual es r.buffer
        el stream_actual es r.stream_siguiente
        el res_paso es r.resultado
        ejecutor.registra res_paso en secuencia
        si res_paso.estado no es "paso":
            el setup_ok es falso
        fin
    fin

    si setup_ok:
        para cada p en definicion.pasos_main:
            la r es ejecuta_con_reintentos de enlace, buffer_actual, stream_actual, p.nombre, p.reintentos
            el buffer_actual es r.buffer
            el stream_actual es r.stream_siguiente
            el res_paso es r.resultado
            ejecutor.registra res_paso en secuencia
            si res_paso.estado no es "paso":
                rompe
            fin
        fin
    fin

    para cada p en definicion.pasos_cleanup:
        la r es ejecuta_con_reintentos de enlace, buffer_actual, stream_actual, p.nombre, p.reintentos
        el buffer_actual es r.buffer
        el stream_actual es r.stream_siguiente
        ejecutor.registra r.resultado en secuencia
    fin

    devuelve secuencia
fin
