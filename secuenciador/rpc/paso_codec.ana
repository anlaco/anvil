# idioma: es
# Codifica/decodifica los mensajes de rpc/paso.proto. Corre con el
# directorio de trabajo en la RAÍZ del repo (no en grpc/ ni en
# secuenciador/): es la única convención que funciona al componer
# módulos de las dos carpetas en un mismo programa (ver anlaco-lang#9 —
# un módulo cargado con ruta de subcarpeta no puede depender de módulos
# hermanos por nombre corto, así que todo el árbol tiene que usar rutas
# completas desde la raíz). Ver ejecutor_pasos.ana y motor.ana.

usa "grpc/protobuf"

define codifica_peticion_paso de un nombre, un intento:
    los c1 son protobuf.codifica_campo_texto de 1, nombre
    los c2 son protobuf.codifica_campo_entero de 2, intento
    devuelve protobuf.concatena de c1, c2
fin

un peticion_paso_decodificada tiene:
    un nombre_bytes
    un intento
fin

define decodifica_peticion_paso de datos:
    el c1 es protobuf.lee_campo_pb de datos, 1
    el c2 es protobuf.lee_campo_pb de datos, c1.siguiente
    devuelve un nuevo peticion_paso_decodificada con el nombre_bytes c1.valor_bytes, el intento c2.valor_varint
fin

# Campos opcionales (valor_medido/limite_min/limite_max): en proto3 los
# campos con el valor por defecto (texto vacío) no se mandan — así lo
# hace la librería oficial (verificado con protobuf de Python antes de
# escribir esto), así que aquí se hace lo mismo.
define texto_o_vacio de un valor:
    si valor es nada:
        devuelve ""
    fin
    devuelve "{valor}"
fin

define codifica_resultado_paso de una r:
    los c1 son protobuf.codifica_campo_texto de 1, r.nombre
    los c2 son protobuf.codifica_campo_texto de 2, r.estado
    los c3 son protobuf.codifica_campo_texto de 3, r.mensaje
    la mensaje son protobuf.concatena de c1, c2
    la mensaje son protobuf.concatena de mensaje, c3

    el t_valor es texto_o_vacio de r.valor_medido
    si (cantidad de t_valor) es mayor que 0:
        los c4 son protobuf.codifica_campo_texto de 4, t_valor
        la mensaje son protobuf.concatena de mensaje, c4
    fin
    el t_min es texto_o_vacio de r.limite_min
    si (cantidad de t_min) es mayor que 0:
        los c5 son protobuf.codifica_campo_texto de 5, t_min
        la mensaje son protobuf.concatena de mensaje, c5
    fin
    el t_max es texto_o_vacio de r.limite_max
    si (cantidad de t_max) es mayor que 0:
        los c6 son protobuf.codifica_campo_texto de 6, t_max
        la mensaje son protobuf.concatena de mensaje, c6
    fin
    devuelve mensaje
fin

un resultado_paso_decodificado tiene:
    un nombre_bytes
    un estado_bytes
    un mensaje_bytes
fin

# Solo decodifica los tres campos de texto que el motor necesita para
# el control de flujo y el reporte (nombre/estado/mensaje) — los
# numéricos opcionales no hacen falta para eso.
define decodifica_resultado_paso de datos:
    el c1 es protobuf.lee_campo_pb de datos, 1
    el c2 es protobuf.lee_campo_pb de datos, c1.siguiente
    el c3 es protobuf.lee_campo_pb de datos, c2.siguiente
    devuelve un nuevo resultado_paso_decodificado con el nombre_bytes c1.valor_bytes, el estado_bytes c2.valor_bytes, el mensaje_bytes c3.valor_bytes
fin
