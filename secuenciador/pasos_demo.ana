# idioma: es
# Los pasos de la secuencia de ejemplo "basica" — extraídos de
# ejemplos/basica.ana para que los pueda usar tanto la Fase 1 (llamada
# Ana directa, sin red) como el ejecutor de pasos por gRPC (rpc/).
# Todos toman "intento_" aunque la mayoría lo ignore: es la convención
# uniforme que necesita el despacho por nombre (ver rpc/ejecutor_pasos.ana).

usa "secuenciador/modelo"

define paso_conectar de un intento_:
    si intento_ es menor que 2:
        devuelve un nuevo resultado_step con el nombre "conectar_equipo", el estado "fallo", el mensaje "el equipo no respondió (intento {intento_})"
    fin
    devuelve un nuevo resultado_step con el nombre "conectar_equipo", el estado "paso", el mensaje "equipo conectado (intento {intento_})"
fin

define paso_medir_voltaje de un intento_:
    el valor es 4.2
    si valor es menor que 4.5:
        devuelve un nuevo resultado_step con el nombre "medir_voltaje", el estado "fallo", el mensaje "voltaje fuera de rango", el valor_medido valor, el limite_min 4.5, el limite_max 5.5
    fin
    devuelve un nuevo resultado_step con el nombre "medir_voltaje", el estado "paso", el mensaje "voltaje dentro de rango", el valor_medido valor, el limite_min 4.5, el limite_max 5.5
fin

define paso_verificar_led de un intento_:
    devuelve un nuevo resultado_step con el nombre "verificar_led", el estado "paso", el mensaje "led encendido"
fin

define paso_desconectar de un intento_:
    devuelve un nuevo resultado_step con el nombre "desconectar_equipo", el estado "paso", el mensaje "equipo desconectado"
fin
