# idioma: es

usa "secuenciador/modelo"
usa "secuenciador/ejecutor"
usa "secuenciador/pasos_demo"

el secuencia es un nuevo resultado_secuencia con el nombre "basica", el pasos []

# --- Setup: reintenta conectar hasta 3 veces ---
el intentos es 0
el conectado es falso
el r_conectar es pasos_demo.paso_conectar de 1
mientras intentos es menor que 3 y conectado no es verdadero:
    el intentos es (intentos + 1)
    el r_conectar es pasos_demo.paso_conectar de intentos
    si r_conectar.estado es "paso":
        el conectado es verdadero
    fin
fin
ejecutor.registra r_conectar en secuencia

# --- Main: solo si Setup salió bien; si un paso falla, se salta el resto ---
si conectado:
    el r_voltaje es pasos_demo.paso_medir_voltaje de 1
    ejecutor.registra r_voltaje en secuencia

    si r_voltaje.estado es "paso":
        el r_led es pasos_demo.paso_verificar_led de 1
        ejecutor.registra r_led en secuencia
    fin
fin

# --- Cleanup: corre siempre, pase lo que pase en Setup/Main ---
el r_desconectar es pasos_demo.paso_desconectar de 1
ejecutor.registra r_desconectar en secuencia

ejecutor.reporte a secuencia
