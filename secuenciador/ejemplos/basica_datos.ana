# idioma: es
# La misma secuencia "basica" de basica.ana, pero como DATOS (una
# definicion_secuencia) corrida por el motor genérico — cada paso se
# invoca por gRPC contra ejecutor_pasos.ana, no con una llamada Ana
# directa. Antes de correr esto, en otra terminal:
#   bin/anac ejecutar secuenciador/rpc/ejecutor_pasos.ana
# Y esto, desde la raíz del repo:
#   bin/anac ejecutar secuenciador/ejemplos/basica_datos.ana

usa "secuenciador/modelo"
usa "secuenciador/ejecutor"
usa "secuenciador/rpc/motor"

la def_conectar es un nuevo definicion_paso con el nombre "conectar_equipo", el reintentos 3
la def_voltaje es un nuevo definicion_paso con el nombre "medir_voltaje", el reintentos 1
la def_led es un nuevo definicion_paso con el nombre "verificar_led", el reintentos 1
la def_desconectar es un nuevo definicion_paso con el nombre "desconectar_equipo", el reintentos 1

la definicion es un nuevo definicion_secuencia con el nombre "basica_datos", el pasos_setup [def_conectar], el pasos_main [def_voltaje, def_led], el pasos_cleanup [def_desconectar]

la cx es motor.conecta de "127.0.0.1", 9100
si cx es nada:
    detente con "no se pudo conectar al ejecutor de pasos"
fin
escribe "conectado al ejecutor de pasos"

la secuencia es motor.ejecuta_secuencia de cx.enlace, cx.buffer, 1, definicion

cierra cx.enlace

ejecutor.reporte a secuencia
